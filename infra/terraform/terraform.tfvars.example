# Copy to terraform.tfvars (gitignored) and fill in.
project_id            = "your-gcp-project-id"
github_repository     = "your-github-user/your-repo"
first_superuser_email = "you@example.com"

# Email: sign-in codes, password resets and contact notices need SMTP. The SMTP password goes in Secret Manager
# (infra/README.md). smtp_port defaults to 587 with STARTTLS. Gmail's SMTP refuses logins from Cloud Run; a
# transactional sender such as Resend (smtp_user "resend", smtp_host "smtp.resend.com") works.
contact_email = "you@example.com"
emails_from   = "no-reply@example.com"
smtp_user     = ""
smtp_host     = ""

# Leave both empty for the first apply. Setting domain adds the load balancer (infra/README.md, step 5).
domain     = ""
public_url = ""
# domain     = "checker.example.com"
# public_url = "https://checker.example.com"

# Browser extension IDs allowed to call the free check (extension/README.md).
# extension_ids = ["lfepfedddcabkigmmhbhacdllgljpdbe"]

# Your own public addresses, which skip the weekly free-check quota for testing the live site.
# free_check_allowlist_ips = ["203.0.113.9"]

# Accounts: let anyone sign up (you pay for their checks), and cap each account's checks in any 30 days.
# signup_open                = false
# account_checks_per_30_days = 0
