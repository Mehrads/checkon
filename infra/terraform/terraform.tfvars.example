# Copy to terraform.tfvars (gitignored) and fill in.
project_id            = "your-gcp-project-id"
github_repository     = "your-github-user/your-repo"
first_superuser_email = "you@example.com"

# Contact form notices: where messages go, and the mailbox that sends them.
# info@checkon.ca is a Google Workspace mailbox; the password is an app password in Secret Manager
# (infra/README.md, step 4). smtp_port defaults to 587 with STARTTLS, which is what Gmail expects.
contact_email = "info@checkon.ca"
emails_from   = "info@checkon.ca"
smtp_user     = "info@checkon.ca"
smtp_host     = "smtp.gmail.com"

# Leave both empty for the first apply. Setting domain adds the load balancer (infra/README.md, step 5).
domain     = ""
public_url = ""
# domain     = "checkon.ca"
# public_url = "https://checkon.ca"

# Browser extension IDs allowed to call the free check (extension/README.md).
# extension_ids = ["lfepfedddcabkigmmhbhacdllgljpdbe"]

# Your own public addresses, which skip the weekly free-check quota for testing the live site.
# free_check_allowlist_ips = ["203.0.113.9"]

# Paid plans: live-mode price ids from the Stripe Dashboard (infra/README.md, "Stripe"). Empty keeps
# Checkout off, and the pricing page offers the contact form instead.
# stripe_price_starter     = "price_..."
# stripe_price_agency      = "price_..."
# stripe_price_extra_check = "price_..."
# stripe_automatic_tax     = false # true once registered for GST/HST
