VITE_API_URL=http://localhost:8000
MAILPIT_HOST=http://localhost:8025
# The site's public address: canonical links, link previews, the sitemap and robots.txt use it.
# Set it to your own domain when you build for production.
VITE_SITE_URL=http://localhost:5173
# Shown as a mailto link next to the contact form and on the privacy and terms pages; leave empty to hide it
VITE_CONTACT_EMAIL=
# Umami Cloud website id; leave empty to turn page counting off (it only counts VITE_SITE_URL's domain)
VITE_UMAMI_WEBSITE_ID=
