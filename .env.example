# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="CheckON"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Claude API (Inspector and Refiner). Use a personal key; leave empty to run without LLM calls.
ANTHROPIC_API_KEY=

# Langfuse traces, metadata only (infra/README.md, "Langfuse"). Leave empty to keep tracing off; use a separate
# Langfuse project for local runs.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Free check limits, for visitors who aren't signed in
FREE_CHECKS_PER_WEEK=1
FREE_CHECK_DAILY_SPEND_CAP_USD=5

# Contact form: messages are saved, and emailed here when the SMTP settings above work.
CONTACT_EMAIL=

# Signed-in accounts: let anyone sign up (you pay for their checks), and cap each account's checks in any
# 30 days (0: no limit). Off and 0 by default.
SIGNUP_OPEN=false
ACCOUNT_CHECKS_PER_30_DAYS=0
