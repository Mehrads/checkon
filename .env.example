# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Claude API (Inspector and Refiner). Use a personal key; leave empty to run without LLM calls.
ANTHROPIC_API_KEY=
